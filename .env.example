# Copy this file to .env and fill in real values. Never commit .env (see .gitignore).
# Every value here is a placeholder — Sentinel never ships or assumes a default secret.

# --- RPC providers (spec SPEC.md #6.1: at least two independent providers per chain) ---
ETH_RPC_PRIMARY=
ETH_RPC_SECONDARY=
ETH_RPC_ARCHIVE=
BASE_RPC_PRIMARY=
BASE_RPC_SECONDARY=
BASE_RPC_ARCHIVE=

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# --- Execution (Phase 8+; leave unset until Phase 8 is complete and you enable it) ---
# The bot's signing key, from an encrypted keystore reference or env var — never a
# seed phrase, and never committed. Sentinel will refuse to sign anything if
# EXECUTION_MODE (in config, not here) is anything other than "off" or "paper" unless
# you have completed and reviewed Phase 8 yourself.
BOT_PRIVATE_KEY=
