# Copy this file to .env and fill in real values. Never commit .env.

# Required always — your wallet's private key, holding the shares configured
# in config/stoploss.json. Never a seed phrase. Never logged or printed by
# this bot.
WALLET_PRIVATE_KEY=

# Required only when config's executionMode is "live" — Polymarket CLOB L2 API
# credentials (see README.md's "Going live" section for how to obtain these).
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
