# systemd unit as an alternative to Docker (docs/SPEC.md §9 Phase 9) — runs the built
# CLI directly on the host instead of in a container. Install:
#
#   sudo useradd --system --home /opt/sentinel --shell /usr/sbin/nologin sentinel
#   sudo cp -r . /opt/sentinel && cd /opt/sentinel && pnpm install --frozen-lockfile --prod && pnpm build
#   sudo mkdir -p /var/lib/sentinel && sudo chown sentinel:sentinel /var/lib/sentinel
#   sudo chown -R sentinel:sentinel /opt/sentinel
#   sudo cp docker/systemd/sentinel.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sentinel
#
# Secrets (RPC URLs, bot tokens) come from /etc/sentinel/sentinel.env (chmod 600,
# owned by the sentinel user) — never from this unit file, which is world-readable by
# default (safety rule 1).

[Unit]
Description=Sentinel — DeFi stablecoin position watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel
EnvironmentFile=/etc/sentinel/sentinel.env
ExecStart=/usr/bin/node /opt/sentinel/dist/cli/index.js watch \
    --config /opt/sentinel/config/sentinel.yaml \
    --db /var/lib/sentinel/sentinel.sqlite
Restart=on-failure
RestartSec=5s

# See docker-compose.yml's stop_grace_period comment — same reasoning: the current
# poll iteration (up to every configured chain's worst-case RPC retry sequence) needs
# real room to finish and close the database cleanly before SIGKILL.
TimeoutStopSec=30s
KillSignal=SIGTERM

# Standard hardening — sentinel only needs to read its config/database directory and
# make outbound HTTPS calls; nothing here narrows anything the app actually needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentinel /opt/sentinel/reports /opt/sentinel/backups

[Install]
WantedBy=multi-user.target
